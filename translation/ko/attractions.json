 },
 {
  "id": 3476,
  "ko": "적을 알고 나를 알면\n백 번 싸워도 위태롭지 않다."
 },
 {
  "id": 3481,
  "ko": "오늘도 수리검 수련을 합시다."
 },
 {
  "id": 3484,
  "ko": "준비가 되면 GamePad의\n빨간 화살표를 이쪽으로 돌려 주십시오."
 },
 {
  "id": 3489,
  "ko": "북을 과녁 삼아\n어깨를 풉시다."
 },
 {
  "id": 3490,
  "ko": "훌륭합니다."
 },
 {
  "id": 3491,
  "ko": "하지만 오늘은 던지는 솜씨가\n무뎠군요."
 },
 {
  "id": 3492,
  "ko": "첫 번째 투척은\n제법이었습니다."
 },
 {
  "id": 3493,
  "ko": "두 번째 투척은\n제법이었습니다."
 },
 {
  "id": 3494,
  "ko": "마지막 투척은\n제법이었습니다."
 },
 {
  "id": 3495,
  "ko": "{0:3:0002}{6:1:00000000}{0:3:ffff} 공\n실력이 한층 느셨군요."
 },
 {
  "id": 3496,
  "ko": "날카로운 투척.\n역시 {0:3:0002}{6:1:00000000}{0:3:ffff} 공이십니다."
 },
 {
  "id": 3497,
  "ko": "재빨리 그으면\n더 날카로운 수리검을 던질 수 있습니다."
 },
 {
  "id": 3498,
  "ko": "두 번째는 없다고 명심하고\n적을 해치우십시오."
 },
 {
  "id": 3503,
  "ko": "앗, 무슨 짓이오!\n이 무뢰한~"
 },
 {
  "id": 3504,
  "ko": "{0:3:0002}{6:1:00000000}{0:3:ffff} 공\n나를 구해 주시오~"
 },
 {
  "id": 3506,
  "ko": "{0:3:0002}{6:1:00000000}{0:3:ffff} 공\n내 목소리가 들리시오?"
 },
 {
  "id": 3507,
  "ko": "이것은 이심전신의 술법.\n그대의 마음에 직접 말을 걸고 있소.",
  "note": "以心電信(以心伝心 말장난)=「이심전신」(전심→전신 電信), 결정 필요"
 },
 {
  "id": 3512,
  "ko": "이 앞의 더 큰 고난을\n넘어서기 위해서는"
 },
 {
  "id": 3513,
  "ko": "{2:17:00000064fffffff6}에 대해서도\n배워야 하오."
 },
 {
  "id": 3514,
  "ko": "만약 {2:17:00000064fffffff6} 이것을\n손에 넣는다면",
  "note": "{2:17}(두루마리 그림) 뒤 조사를 피하려고 「, 그것을」 문형"
 },
 {
  "id": 3515,
  "ko": "GamePad 위에\n원을 그리시오."
 },
 {
  "id": 3516,
  "ko": "그러면 적도 쓰고 있는\n터지는 불덩이를 쓸 수 있을 것이오."
 },
 {
  "id": 3517,
  "ko": "아시겠소? 쓸 때는\n원을 그리는 것이오."
 },
 {
  "id": 3519,
  "ko": "{0:3:0002}{6:1:00000000}{0:3:ffff} 공\n내 목소리가 들리시오?"
 },
 {
  "id": 3520,
  "ko": "{2:17:00000064fffffff6}에는 아직 숨겨진\n힘이 깃들어 있소."
 },
 {
  "id": 3521,
  "ko": "적이 빨라서 그 움직임을 잡기가\n어려울 때에는"
 },
 {
  "id": 3522,
  "ko": "GamePad 위에\n가로 일자를 그리시오."
 },
 {
  "id": 3523,
  "ko": "그러면 의식이\n예리하게 벼려져"
 },
 {
  "id": 3524,
  "ko": "적의 움직임을 잡을 수\n있을 것이오."
 },
 {
  "id": 3525,
  "ko": "아시겠소?\n가로 일자를 그리는 것이오."
 },
 {
  "id": 3527,
  "ko": "{0:3:0002}{6:1:00000000}{0:3:ffff} 공\n내 목소리가 들리시오?"
 },
 {
  "id": 3528,
  "ko": "{2:17:00000064fffffff6}에는 또 하나\n마지막 힘이 깃들어 있소."
 },
 {
  "id": 3529,
  "ko": "한꺼번에 많은 적에게\n습격당했을 때에는"
 },
 {
  "id": 3530,
  "ko": "GamePad 위에\nV라는 이국의 글자를 그리시오."
 },
 {
  "id": 3531,
  "ko": "그러면 손끝에\n신속의 힘이 넘쳐흘러"
 },
 {
  "id": 3532,
  "ko": "한꺼번에 많은 적을 쓰러뜨릴\n수 있을 것이오."
 },
 {
  "id": 3533,
  "ko": "아시겠소?\nV라는 글자를 그리는 것이오."
 },
 {
  "id": 3535,
  "ko": "오오, {0:3:0002}{6:1:00000000}{0:3:ffff} 공\n거기 계셨구려."
 },
 {
  "id": 3536,
  "ko": "그대 덕분에 나도\n마침내 풀려났소."
 },
 {
  "id": 3537,
  "ko": "이번 활약은 훌륭하였소."
 },
 {
  "id": 3538,
  "ko": "이제 수리검 수련은\n충분하오."
 },
 {
  "id": 3539,
  "ko": "상은 원하는 대로 내리겠소.\n가슴을 펴고 고향으로 돌아가시오."
 },
 {
  "id": 3541,
  "ko": "크으으…\n감히 내 정체를 꿰뚫어 보다니."
 },
 {
  "id": 3543,
  "ko": "{0:3:0002}{6:1:00000000}{0:3:ffff} 공\n내 목소리가 들리시오?"
 },
 {
  "id": 3544,
  "ko": "가짜의 정체를 꿰뚫어 보다니\n그대의 안목에는 감복하였소."
 },
 {
  "id": 3545,
  "ko": "여기서부터는 한 번에 던질 수 있는\n수리검이 적어지니"
 },
 {
  "id": 3546,
  "ko": "한 발에 혼을 담아\n헛되이 던지는 일이 없도록 하시오.",
  "note": "一打入魂(一球入魂 말장난)=「일타입혼」, 결정 필요"
 },
 {
  "id": 3563,
  "ko": "그대의 도움을\n기다리고 있겠소."
 },
 {
  "id": 3567,
  "ko": "오오, {0:3:0002}{6:1:00000000}{0:3:ffff} 공\n거기 계셨소?"
 },
 {
  "id": 3568,
  "ko": "그대 덕분에 나도\n마침내 풀려났구려."
 },
 {
  "id": 3569,
  "ko": "이번 활약은\n참으로 훌륭하였소."
